From b2eaca71aa6730cdeb7822b0a141becff6b2d266 Mon Sep 17 00:00:00 2001
From: Jared Wolff <hello@jaredwolff.com>
Date: Wed, 14 Oct 2026 09:38:00 -0400
Subject: [PATCH 1/2] drivers: serial: nrfx_uarte: Resync legacy RX byte count
 on RX start

With CONFIG_UARTE_NRFX_UARTE_COUNT_BYTES_WITH_TIMER_LEGACY, the idle
line handler reports the bytes counted by the TIMER (RXDRDY via PPI)
beyond total_user_byte_cnt. That total is also advanced from RX.AMOUNT
at ENDRX and from FIFO flushes. On a line with errors (framing, overrun)
these do not match the RXDRDY count, and the total ends up ahead of the
counter. The difference then wraps, the handler reports nothing, and
the end of every later transfer stays undelivered until the buffer
fills; the drift persists across RX restarts.

Seen on an nRF9151 at 921600 baud without flow control: after overruns
the counter was 2 bytes behind the total, so every command after the
first lost its last 2 bytes, including the line terminator, and the
peer timed out.

Align the total with the counter right before STARTRX. For that to be
exact the FIFO must be empty there: bytes left in it when RX stopped
(e.g. received after the last buffer filled) are counted already and
would otherwise move into the new buffer at STARTRX unaccounted for.
So with TIMER byte counting, flush the FIFO when RX stops and copy the
bytes into the next buffer, as the low power mode already does, and
subtract those carried bytes from the counter.
---
 drivers/serial/uart_nrfx_uarte.c | 38 ++++++++++++++++++++++++++++++--
 1 file changed, 36 insertions(+), 2 deletions(-)

diff --git a/drivers/serial/uart_nrfx_uarte.c b/drivers/serial/uart_nrfx_uarte.c
index e0449fe7c0e..423e1a5ecc1 100644
--- a/drivers/serial/uart_nrfx_uarte.c
+++ b/drivers/serial/uart_nrfx_uarte.c
@@ -1940,10 +1940,17 @@ static int uarte_nrfx_rx_enable(const struct device *dev, uint8_t *buf,
 	}
 #endif
 
-	if (IS_ENABLED(CONFIG_PM_DEVICE_RUNTIME) || LOW_POWER_ENABLED(cfg)) {
+	/* Bytes from the previous FIFO flush copied into the new buffer: counted by
+	 * the hardware already, not passed to the user yet.
+	 */
+	size_t carried = 0;
+
+	if (IS_ENABLED(CONFIG_PM_DEVICE_RUNTIME) || LOW_POWER_ENABLED(cfg) || IS_CBWT_LEGACY(dev)) {
 		if (async_rx->flush_cnt) {
 			int cpy_len = MIN(len, async_rx->flush_cnt);
 
+			carried = cpy_len;
+
 			if (IS_ENABLED(UARTE_ANY_CACHE) &&
 			    (cfg->flags & UARTE_CFG_FLAG_CACHEABLE)) {
 				sys_cache_data_invd_range(cfg->rx_flush_buf, cpy_len);
@@ -1986,6 +1993,27 @@ static int uarte_nrfx_rx_enable(const struct device *dev, uint8_t *buf,
 
 	nrf_uarte_rx_buffer_set(uarte, buf, len);
 
+#ifdef CONFIG_UARTE_NRFX_UARTE_COUNT_BYTES_WITH_TIMER_LEGACY
+	if (IS_CBWT_LEGACY(dev)) {
+		/* The idle line handler reports the bytes counted by the TIMER beyond
+		 * total_user_byte_cnt. That total is also advanced from RX.AMOUNT at
+		 * ENDRX and from FIFO flushes, which do not match the RXDRDY count
+		 * when the line has errors (framing, overrun): the total then ends
+		 * up ahead of the counter, the difference wraps, and no more data is
+		 * reported until the buffer fills. Bytes left in the FIFO when RX
+		 * stopped were flushed by rxto_isr() and copied to the new buffer
+		 * above (carried), so the FIFO is empty and nothing else of the new
+		 * buffer has been received before STARTRX: align the total with the
+		 * counter here.
+		 */
+		nrf_timer_task_trigger(cfg->timer_regs, NRF_TIMER_TASK_CAPTURE0);
+		nrf_barrier_rw();
+		async_rx->total_user_byte_cnt = nrf_timer_cc_get(cfg->timer_regs, 0) - carried;
+	}
+#else
+	ARG_UNUSED(carried);
+#endif
+
 	if (IS_ENABLED(CONFIG_HAS_HW_NRF_UARTE120) && (cfg->flags & UARTE_CFG_FLAG_CACHEABLE)) {
 		/* Spurious RXTO event was seen on fast instance (UARTE120) thus
 		 * RXTO interrupt is kept enabled only when RX is active.
@@ -2417,7 +2445,13 @@ static void rxto_isr(const struct device *dev)
 			async_rx->total_user_byte_cnt += rx_flush(dev);
 		}
 #endif
-	} else if (IS_ENABLED(CONFIG_PM_DEVICE_RUNTIME) || LOW_POWER_ENABLED(config)) {
+	} else if (IS_ENABLED(CONFIG_PM_DEVICE_RUNTIME) || LOW_POWER_ENABLED(config) ||
+		   IS_CBWT_LEGACY(dev)) {
+		/* Keep bytes left in the FIFO for the next buffer. With TIMER byte
+		 * counting they are counted already; flushing them here keeps the
+		 * FIFO empty at the next STARTRX, so uarte_nrfx_rx_enable() knows
+		 * exactly which counted bytes are still to be reported.
+		 */
 		async_rx->flush_cnt = rx_flush(dev);
 	}
 
